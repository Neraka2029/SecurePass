RewriteEngine On

# Désactiver l'affichage des fichiers
Options -Indexes

# Sécuriser les fichiers sensibles
<FilesMatch "^(\.htaccess|\.gitignore|\.env|config\.php|database\.php)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Rediriger les URLs avec .php vers leurs versions sans .php
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# Si le fichier demandé n'existe pas, ajouter .php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L,QSA]
